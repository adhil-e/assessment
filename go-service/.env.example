# Go PDF Report Generation Service Configuration

# ============================================
# Server Settings
# ============================================

# Port for the Go service to listen on
PORT=8080

# URL of the Node.js backend API
NODE_API_URL=http://localhost:5007

# ============================================
# Cache Settings
# ============================================

# How long to cache student data (in seconds)
# Default: 300 (5 minutes)
CACHE_TTL_SECONDS=300

# How often to clean up expired cache entries (in seconds)
# Default: 60 (1 minute)
CACHE_CLEANUP_SECONDS=60

# ============================================
# Rate Limiter Settings
# ============================================

# Maximum requests allowed per second per client
# Default: 10
RATE_LIMIT_PER_SECOND=10

# Maximum burst size (token bucket capacity)
# Allows temporary spikes above the rate limit
# Default: 20
RATE_LIMIT_BURST=20

# How often to clean up inactive rate limit buckets (in seconds)
# Default: 300 (5 minutes)
RATE_LIMIT_CLEANUP_SECONDS=300

# Remove rate limit tracking for clients inactive for this duration (in seconds)
# Default: 600 (10 minutes)
RATE_LIMIT_INACTIVITY_SECONDS=600
